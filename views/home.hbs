      <div class="feat-main-body">
        <div class="feat-sm-cat">{{featuredWorks.[0].division}} · {{featuredWorks.[0].year}}</div>
        <h3 class="feat-main-title">
          <span class="li on" data-lang="id">{{featuredWorks.[0].titleId}}</span>
          <span class="li" data-lang="en">{{featuredWorks.[0].titleEn}}</span>
          <span class="li" data-lang="ar">{{featuredWorks.[0].titleAr}}</span>
          <span class="li" data-lang="zh">{{featuredWorks.[0].titleZh}}</span>
        </h3>
        <p class="feat-main-desc">
          <span class="li on" data-lang="id">{{featuredWorks.[0].descId}}</span>
          <span class="li" data-lang="en">{{featuredWorks.[0].descEn}}</span>
          <span class="li" data-lang="ar">{{featuredWorks.[0].descAr}}</span>
          <span class="li" data-lang="zh">{{featuredWorks.[0].descZh}}</span>
        </p>
        <span class="sbtn-p-sm"><span class="li on" data-lang="id">Tonton</span><span class="li" data-lang="en">Watch</span><span class="li" data-lang="ar">شاهد</span><span class="li" data-lang="zh">观看</span></span>
      </div>
    </a>
    <div class="feat-side">
      {{#each featuredWorks}}{{#unless featured}}
      <a href="/works/{{id}}" class="feat-sm">
        <div class="feat-sm-thumb" style="background-image:url('{{image}}');"></div>
        <div class="feat-sm-body">
          <div class="feat-sm-cat">{{division}}</div>
          <div class="feat-sm-title">
            <span class="li on" data-lang="id">{{titleId}}</span>
            <span class="li" data-lang="en">{{titleEn}}</span>
            <span class="li" data-lang="ar">{{titleAr}}</span>
            <span class="li" data-lang="zh">{{titleZh}}</span>
