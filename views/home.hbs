  <div class="sec-hdr">
    <div>
      <p class="sec-lbl">Film &amp; Series</p>
      <h2 class="sec-ttl"><span class="li on" data-lang="id">Film &amp; Web Series</span><span class="li" data-lang="en">Film &amp; Web Series</span><span class="li" data-lang="ar">الأفلام والمسلسلات</span><span class="li" data-lang="zh">电影与网络剧</span></h2>
    </div>
