<!-- VIDEO SECTION -->
<section class="video-section" id="videos">
  <div class="sec-full">
    <div class="sec-hdr" style="border-bottom-color:rgba(45,106,79,0.2);">
      <div>
        <p class="sec-lbl"><span class="li on" data-lang="id">Tonton Sekarang</span><span class="li" data-lang="en">Watch Now</span><span class="li" data-lang="ar">شاهد الآن</span><span class="li" data-lang="zh">立即观看</span></p>
        <h2 class="sec-ttl"><span class="li on" data-lang="id">Video Terbaru HUD</span><span class="li" data-lang="en">Latest HUD Videos</span><span class="li" data-lang="ar">أحدث مقاطع HUD</span><span class="li" data-lang="zh">HUD最新视频</span></h2>
      </div>
      <a href="https://youtube.com" target="_blank" rel="noopener" class="sec-more">YouTube →</a>
    </div>
    <div class="video-main-wrap">
      <div>
        <div class="video-player" id="videoPlayer">
          <div class="video-player-bg"></div>
          <img class="video-thumb" id="videoThumb" src="{{videos.[0].thumb}}" alt="video thumbnail">
          <div class="video-play-btn">
            <svg width="22" height="22" viewBox="0 0 22 22"><polygon points="7,3 19,11 7,19" fill="#52B788"/></svg>
          </div>
          <div class="video-time" id="videoTime">{{videos.[0].duration}}</div>
        </div>
        <div class="video-info">
          <div class="video-info-cat" id="videoCat">{{videos.[0].category}}</div>
          <h3 class="video-info-title" id="videoTitle">
            <span class="li on" data-lang="id" id="vt-id">{{videos.[0].titleId}}</span>
            <span class="li" data-lang="en" id="vt-en">{{videos.[0].titleEn}}</span>
            <span class="li" data-lang="ar" id="vt-ar">{{videos.[0].titleAr}}</span>
            <span class="li" data-lang="zh" id="vt-zh">{{videos.[0].titleZh}}</span>
          </h3>
          <p class="video-info-desc">
            <span class="li on" data-lang="id" id="vd-id">{{videos.[0].descId}}</span>
            <span class="li" data-lang="en" id="vd-en">{{videos.[0].descEn}}</span>
            <span class="li" data-lang="ar" id="vd-ar">{{videos.[0].descAr}}</span>
            <span class="li" data-lang="zh" id="vd-zh">{{videos.[0].descZh}}</span>
          </p>
        </div>
      </div>
      <div class="video-playlist">
        {{#each videos}}
        <div class="vp-item{{#eq @index 0}} on{{/eq}}" onclick="selectVideo(this,
          '{{titleId}}','{{titleEn}}','{{titleAr}}','{{titleZh}}',
          '{{descId}}','{{descEn}}','{{descAr}}','{{descZh}}',
          '{{category}}','{{duration}}','{{thumb}}'
        )">
          <div class="vp-thumb" style="background-image:url('{{thumb}}');"></div>
          <div>
            <div class="vp-cat">{{category}}</div>
            <div class="vp-title">
              <span class="li on" data-lang="id">{{titleId}}</span>
              <span class="li" data-lang="en">{{titleEn}}</span>
              <span class="li" data-lang="ar">{{titleAr}}</span>
              <span class="li" data-lang="zh">{{titleZh}}</span>
            </div>
            <div class="vp-dur">{{duration}}</div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

