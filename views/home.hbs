<!-- DIV TABS -->
<div class="divnav" id="divnav">
  <button class="divtab on" onclick="switchDiv('all',this)">
    <span class="li on" data-lang="id">Semua Karya</span><span class="li" data-lang="en">All Works</span><span class="li" data-lang="ar">كل الأعمال</span><span class="li" data-lang="zh">全部作品</span>
  </button>
  <button class="divtab" onclick="switchDiv('film',this)">Film &amp; Series</button>
  <button class="divtab" onclick="switchDiv('digital',this)">Digital Content</button>
  <button class="divtab" onclick="switchDiv('brand',this)">Brand Film</button>
  <button class="divtab" onclick="switchDiv('animasi',this)">Animasi</button>
  <button class="divtab" onclick="switchDiv('dok',this)">Dokumenter</button>
  <button class="divtab" onclick="switchDiv('podcast',this)">Cinematic Podcast</button>
</div>

<!-- HERO CAROUSEL -->
<section class="hero-wrap" id="hero">
  <div class="hero-slides" id="heroSlides">
    {{#each heroSlides}}
    <div class="hero-slide" style="background-image:url('{{image}}');" data-div="{{id}}">
      <div class="hero-overlay"></div>
      <div class="slide-content">
        <div class="slide-cat">{{division}}</div>
        <h1 class="slide-title">
          <span class="li on" data-lang="id">{{titleId}}</span>
          <span class="li" data-lang="en">{{titleEn}}</span>
          <span class="li" data-lang="ar">{{titleAr}}</span>
          <span class="li" data-lang="zh">{{titleZh}}</span>
        </h1>
        <p class="slide-desc">
          <span class="li on" data-lang="id">{{descId}}</span>
          <span class="li" data-lang="en">{{descEn}}</span>
          <span class="li" data-lang="ar">{{descAr}}</span>
          <span class="li" data-lang="zh">{{descZh}}</span>
        </p>
        <div class="slide-btns">
          <a href="{{ctaLink}}" class="sbtn-p">
            <span class="li on" data-lang="id">{{ctaPrimaryId}}</span>
            <span class="li" data-lang="en">{{ctaPrimaryEn}}</span>
            <span class="li" data-lang="ar">{{ctaPrimaryAr}}</span>
            <span class="li" data-lang="zh">{{ctaPrimaryZh}}</span>
          </a>
          <a href="/works" class="sbtn-g">
            <span class="li on" data-lang="id">{{ctaSecondaryId}}</span>
            <span class="li" data-lang="en">{{ctaSecondaryEn}}</span>
            <span class="li" data-lang="ar">{{ctaSecondaryAr}}</span>
            <span class="li" data-lang="zh">{{ctaSecondaryZh}}</span>
          </a>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  <button class="carousel-prev" onclick="prevSlide()" aria-label="Previous">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 2L4 7L9 12" stroke="#52B788" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="carousel-next" onclick="nextSlide()" aria-label="Next">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2L10 7L5 12" stroke="#52B788" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="carousel-dots" id="heroDots">
    {{#each heroSlides}}
    <button class="cdot{{#eq @index 0}} on{{/eq}}" onclick="goSlide({{@index}})" aria-label="Slide {{@index}}"></button>
    {{/each}}
  </div>
</section>

<!-- TICKER -->
<div class="ticker-wrap">
  <div class="ticker-label">
    <span class="li on" data-lang="id">Terbaru</span>
    <span class="li" data-lang="en">Latest</span>
    <span class="li" data-lang="ar">الأحدث</span>
    <span class="li" data-lang="zh">最新</span>
  </div>
  <div class="ticker-overflow">
    <div class="ticker-track">
      {{#each tickerItems}}<span class="ticker-item">{{this}}</span>{{/each}}
      {{#each tickerItems}}<span class="ticker-item">{{this}}</span>{{/each}}
    </div>
  </div>
</div>

<!-- FEATURED WORKS -->
<section class="sec" id="works">
  <div class="sec-hdr">
    <div>
      <p class="sec-lbl"><span class="li on" data-lang="id">Karya Pilihan</span><span class="li" data-lang="en">Featured Works</span><span class="li" data-lang="ar">أعمال مختارة</span><span class="li" data-lang="zh">精选作品</span></p>
      <h2 class="sec-ttl"><span class="li on" data-lang="id">Terbaru dari HUD</span><span class="li" data-lang="en">Latest from HUD</span><span class="li" data-lang="ar">الأحدث من HUD</span><span class="li" data-lang="zh">HUD最新作品</span></h2>
    </div>
    <a href="/works" class="sec-more"><span class="li on" data-lang="id">Lihat Semua →</span><span class="li" data-lang="en">View All →</span><span class="li" data-lang="ar">عرض الكل →</span><span class="li" data-lang="zh">查看全部 →</span></a>
  </div>
  <div class="feat-wide">
    <a href="/works/{{featuredWorks.[0].id}}" class="feat-main" style="background-image:url('{{featuredWorks.[0].image}}');">
