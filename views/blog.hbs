<section class="page-hero">
  <div class="page-hero-inner">
    <p class="sec-lbl">
      <span class="li on" data-lang="id">Cerita dari tim HUD</span>
      <span class="li" data-lang="en">Stories from the HUD team</span>
      <span class="li" data-lang="ar">قصص من فريق HUD</span>
      <span class="li" data-lang="zh">HUD团队的故事</span>
    </p>
    <h1 class="page-hero-title">
      <span class="li on" data-lang="id">Artikel &amp; Berita</span>
      <span class="li" data-lang="en">Articles &amp; News</span>
      <span class="li" data-lang="ar">مقالات وأخبار</span>
      <span class="li" data-lang="zh">文章与新闻</span>
    </h1>
  </div>
</section>

{{#if categories.length}}
<div class="works-divnav">
  <a class="divtab{{#eq activeCategory 'all'}} on{{/eq}}" href="/blog">
    <span class="li on" data-lang="id">Semua</span>
    <span class="li" data-lang="en">All</span>
    <span class="li" data-lang="ar">الكل</span>
    <span class="li" data-lang="zh">全部</span>
  </a>
  {{#each categories}}
  <a class="divtab{{#eq this ../activeCategory}} on{{/eq}}" href="/blog?cat={{this}}">{{this}}</a>
  {{/each}}
</div>
{{/if}}

<section class="sec">
  {{#if articles.length}}
  <div class="blog-grid">
    {{#each articles}}
    <a href="/blog/{{or slug id}}" class="blog-card">
      {{#if image}}
      <div class="bc-img" style="background-image:url('{{image}}');"></div>
      {{else}}
      <div class="bc-img bc-img-placeholder">
        <svg width="40" height="50" viewBox="0 0 40 50" opacity="0.3">
          <line x1="4" y1="42" x2="36" y2="42" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
          <circle cx="20" cy="16" r="10" fill="none" stroke="#52B788" stroke-width="1"/>
          <circle cx="20" cy="16" r="2.5" fill="#52B788"/>
          <line x1="20" y1="26" x2="20" y2="42" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </div>
      {{/if}}
      <div class="bc-body">
        <div class="bc-meta">
          <span class="bc-cat">{{category}}</span>
          <span class="bc-date">{{formatDateShort createdAt}}</span>
        </div>
        <h2 class="bc-title">
          <span class="li on" data-lang="id">{{or titleId titleEn}}</span>
          <span class="li" data-lang="en">{{or titleEn titleId}}</span>
          <span class="li" data-lang="ar">{{or titleAr titleId}}</span>
          <span class="li" data-lang="zh">{{or titleZh titleId}}</span>
        </h2>
        <p class="bc-excerpt">
          <span class="li on" data-lang="id">{{truncate (or bodyId bodyEn) 120}}</span>
          <span class="li" data-lang="en">{{truncate (or bodyEn bodyId) 120}}</span>
          <span class="li" data-lang="ar">{{truncate (or bodyAr bodyId) 120}}</span>
          <span class="li" data-lang="zh">{{truncate (or bodyZh bodyId) 120}}</span>
        </p>
        <div class="bc-tags">
          {{#each tags}}<span class="bc-tag">{{this}}</span>{{/each}}
        </div>
        <div class="bc-read">
          <span class="li on" data-lang="id">Baca selengkapnya →</span>
          <span class="li" data-lang="en">Read more →</span>
          <span class="li" data-lang="ar">اقرأ المزيد →</span>
          <span class="li" data-lang="zh">阅读更多 →</span>
        </div>
      </div>
    </a>
    {{/each}}
  </div>
  {{else}}
  <div class="empty-state">
    <p>
      <span class="li on" data-lang="id">Belum ada artikel yang diterbitkan.</span>
      <span class="li" data-lang="en">No articles published yet.</span>
      <span class="li" data-lang="ar">لا توجد مقالات منشورة بعد.</span>
      <span class="li" data-lang="zh">暂无已发布的文章。</span>
    </p>
  </div>
  {{/if}}
</section>

<section class="cta-section">
  <div class="cta-inner">
    <h2 class="cta-title">
      <span class="li on" data-lang="id">Punya proyek film?</span>
      <span class="li" data-lang="en">Have a film project?</span>
      <span class="li" data-lang="ar">لديك مشروع فيلم؟</span>
      <span class="li" data-lang="zh">有电影项目吗？</span>
    </h2>
    <a href="/contact" class="sbtn-p">
      <span class="li on" data-lang="id">Hubungi HUD →</span>
      <span class="li" data-lang="en">Contact HUD →</span>
      <span class="li" data-lang="ar">تواصل مع HUD →</span>
      <span class="li" data-lang="zh">联系HUD →</span>
    </a>
  </div>
</section>
