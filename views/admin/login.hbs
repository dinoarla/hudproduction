<div class="login-wrap">
  <div class="login-card">
    <div class="login-logo">
      <svg width="44" height="54" viewBox="0 0 44 54">
        <line x1="4" y1="46" x2="40" y2="46" stroke="#52B788" stroke-width="1.2" stroke-linecap="round"/>
        <circle cx="22" cy="18" r="12" fill="none" stroke="#52B788" stroke-width="1.2"/>
        <circle cx="22" cy="18" r="3" fill="#52B788"/>
        <line x1="22" y1="30" x2="22" y2="46" stroke="#52B788" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    </div>
    <h1 class="login-title">HUD Admin</h1>
    <p class="login-sub">Happiness Until Destination</p>

    {{#if error}}
    <div class="login-error">Username atau password salah.</div>
    {{/if}}

    <form method="POST" action="/admin/login" class="login-form">
      <div class="login-field">
        <label class="lf-label">Username</label>
        <input class="lf-input" type="text" name="username" autocomplete="username" autofocus required>
      </div>
      <div class="login-field">
        <label class="lf-label">Password</label>
        <input class="lf-input" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="login-btn" type="submit">Masuk →</button>
    </form>

    <a class="login-back" href="/">← Kembali ke website</a>
  </div>
</div>

<style>
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
.login-card{width:100%;max-width:380px;border:0.5px solid rgba(45,106,79,0.4);border-radius:12px;padding:40px 36px;background:#111a13;}
.login-logo{text-align:center;margin-bottom:20px;}
.login-title{font-family:'Josefin Sans',sans-serif;font-size:20px;font-weight:100;letter-spacing:8px;text-indent:8px;text-align:center;color:#D8F3DC;text-transform:uppercase;}
.login-sub{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:rgba(82,183,136,0.5);text-align:center;margin-bottom:32px;margin-top:6px;}
.login-error{background:rgba(226,75,74,0.15);border:0.5px solid rgba(226,75,74,0.4);color:#F09595;font-size:11px;padding:10px 14px;border-radius:6px;margin-bottom:20px;text-align:center;}
.login-form{display:flex;flex-direction:column;gap:14px;}
.login-field{display:flex;flex-direction:column;gap:6px;}
.lf-label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:rgba(82,183,136,0.6);}
.lf-input{background:rgba(27,67,50,0.3);border:0.5px solid rgba(45,106,79,0.5);border-radius:4px;padding:12px 14px;color:#D8F3DC;font-family:'DM Mono',monospace;font-size:12px;outline:none;transition:border-color 0.2s;}
.lf-input:focus{border-color:#52B788;}
.login-btn{margin-top:8px;padding:13px;background:#52B788;color:#0A0F0B;border:none;border-radius:4px;font-family:'Josefin Sans',sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:background 0.2s;}
.login-btn:hover{background:#D8F3DC;}
.login-back{display:block;text-align:center;margin-top:24px;font-size:10px;letter-spacing:1.5px;color:rgba(82,183,136,0.45);transition:color 0.2s;}
.login-back:hover{color:#52B788;}
</style>
