<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@100;200;300;400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<aside class="admin-sidebar">
  <a href="/admin" class="admin-logo">
    <svg width="22" height="28" viewBox="0 0 22 28">
      <line x1="2" y1="24" x2="20" y2="24" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
      <circle cx="11" cy="9" r="6" fill="none" stroke="#52B788" stroke-width="1"/>
      <circle cx="11" cy="9" r="1.5" fill="#52B788"/>
      <line x1="11" y1="15" x2="11" y2="24" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
    </svg>
    <span class="admin-logo-text">HUD Admin</span>
  </a>
  <nav class="admin-nav">
    <a class="anav-item" href="/admin">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1"/><rect x="9" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1"/><rect x="1" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1"/><rect x="9" y="9" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1"/></svg>
      Dashboard
    </a>
    <div class="anav-section">Konten</div>
    <a class="anav-item" href="/admin/articles">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1"/><line x1="5" y1="6" x2="11" y2="6" stroke="currentColor" stroke-width="1"/><line x1="5" y1="9" x2="9" y2="9" stroke="currentColor" stroke-width="1"/></svg>
      Artikel
    </a>
    <a class="anav-item" href="/admin/media">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1"/><circle cx="5" cy="7" r="1.5" stroke="currentColor" stroke-width="1"/><path d="M1 11l4-3 3 2 3-3 4 4" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Media
    </a>
    <div class="anav-section">Interaksi</div>
    <a class="anav-item" href="/admin/contacts">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1"/><path d="M1 5l7 5 7-5" stroke="currentColor" stroke-width="1"/></svg>
      Brief Masuk
      {{#if siteSettings}}{{/if}}
    </a>
    <div class="anav-section">Sistem</div>
    <a class="anav-item" href="/admin/settings">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M11.54 4.46l-1.41 1.41M4.46 11.54l-1.41 1.41" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
      Pengaturan
    </a>
    <div class="anav-divider"></div>
    <a class="anav-item" href="/" target="_blank">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M7 3H3a1 1 0 00-1 1v9a1 1 0 001 1h9a1 1 0 001-1V9" stroke="currentColor" stroke-width="1" stroke-linecap="round"/><path d="M10 2h4v4M14 2L8 8" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Lihat Website
    </a>
    <a class="anav-item anav-danger" href="/admin/logout">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 14H3a1 1 0 01-1-1V3a1 1 0 011-1h3M10 11l3-3-3-3M13 8H6" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Logout
    </a>
  </nav>
</aside>

<div class="admin-main">
  <header class="admin-header">
    <h1 class="admin-page-title">{{title}}</h1>
    <div class="admin-header-right">
      <span class="admin-user">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="5" r="3" stroke="#52B788" stroke-width="1"/><path d="M1 13c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="#52B788" stroke-width="1" stroke-linecap="round"/></svg>
        {{adminUser}}
      </span>
    </div>
  </header>

  <div class="admin-content">
    {{{body}}}
  </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
