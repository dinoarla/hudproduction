        <line x1="2" y1="28" x2="24" y2="28" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
        <circle cx="13" cy="10" r="8" fill="none" stroke="#52B788" stroke-width="1"/>
        <circle cx="13" cy="10" r="2" fill="#52B788"/>
        <line x1="13" y1="18" x2="13" y2="28" stroke="#52B788" stroke-width="1" stroke-linecap="round"/>
      </svg>
      <span class="nav-wm">HUD</span>
    </a>
    <nav class="nav-center" aria-label="Main navigation">
      <a class="nav-item" href="/#works" data-div="all">
        <span class="li on" data-lang="id">Karya</span><span class="li" data-lang="en">Works</span><span class="li" data-lang="ar">أعمال</span><span class="li" data-lang="zh">作品</span>
      </a>
      <a class="nav-item" href="/works?div=film">Film &amp; Series</a>
      <a class="nav-item" href="/works?div=brand">Brand Film</a>
      <a class="nav-item" href="/works?div=digital">Digital Content</a>
      <a class="nav-item" href="/works?div=animasi">Animasi</a>
