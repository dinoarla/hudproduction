      <a class="nav-item" href="/works?div=podcast">Podcast</a>
      <a class="nav-item" href="/blog">
        <span class="li on" data-lang="id">Blog</span><span class="li" data-lang="en">Blog</span><span class="li" data-lang="ar">مدونة</span><span class="li" data-lang="zh">博客</span>
      </a>
      <a class="nav-item" href="/about">
        <span class="li on" data-lang="id">Tentang</span><span class="li" data-lang="en">About</span><span class="li" data-lang="ar">عنّا</span><span class="li" data-lang="zh">关于</span>
      </a>
      <a class="nav-item cta-nav" href="/contact">
        <span class="li on" data-lang="id">Kontak</span><span class="li" data-lang="en">Contact</span><span class="li" data-lang="ar">تواصل</span><span class="li" data-lang="zh">联系</span>
      </a>
    </nav>
    <div class="nav-right">
      <div class="lang-switcher">
        <button class="lang-btn on" onclick="setLang('id')">ID</button>
        <button class="lang-btn" onclick="setLang('en')">EN</button>
        <button class="lang-btn" onclick="setLang('ar')">AR</button>
        <button class="lang-btn" onclick="setLang('zh')">中文</button>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Menu" onclick="toggleMenu()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
