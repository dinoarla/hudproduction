    <a class="mob-link" href="/works?div=digital" onclick="toggleMenu()">Digital Content</a>
    <a class="mob-link" href="/works?div=animasi" onclick="toggleMenu()">Animasi</a>
    <a class="mob-link" href="/works?div=dok" onclick="toggleMenu()">Dokumenter</a>
